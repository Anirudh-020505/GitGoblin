GITHUB_APP_ID=
# PEM contents; literal "\n" sequences are converted to newlines.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Any OpenAI-compatible endpoint. Defaults target the Z.ai GLM Coding Plan.
LLM_API_KEY=
# LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# LLM_MODEL=glm-5.3

# Local Postgres from `docker compose up -d postgres` (published on port 5433).
DATABASE_URL=postgresql+asyncpg://gitgoblin:gitgoblin@localhost:5433/gitgoblin
# WORKER_CONCURRENCY=4
